# FalkorDB connection (local Docker or FalkorDB Cloud: redis://default:PASSWORD@HOST:PORT)
HIVEMIND_FALKORDB_URL=redis://127.0.0.1:6379

# Where agents and hooks reach the Hivemind server
HIVEMIND_URL=http://127.0.0.1:8765

# Optional: require "Authorization: Bearer <key>" on /mcp and /api/hook (set this for any public deployment)
HIVEMIND_API_KEY=

# Identity defaults (the installer writes these into each project's config)
HIVEMIND_WORKSPACE=default
HIVEMIND_USER=
HIVEMIND_CLIENT=claude-code
# HIVEMIND_AGENT_ID=claude-code@alice
# HIVEMIND_ROLE=reviewer

# fastembed (local ONNX model, default) or hash (no model, for tests/offline)
HIVEMIND_EMBEDDER=fastembed

# What to do when another live agent is editing the same file: warn | ask | off
HIVEMIND_CONFLICT_MODE=warn
